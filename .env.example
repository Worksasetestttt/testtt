# Copiez ce fichier en .env et adaptez-le. Sans .env, le serveur démarre en mode développement/démo.
PORT=3000
NODE_ENV=development
# URL publique de l'application : utilisée dans les e-mails et les redirections Stripe, et acceptée comme origine
# légitime (en-têtes Origin/Referer) par la protection CSRF, en plus de l'hôte de la requête.
APP_URL=http://localhost:3000
# Obligatoire en production, 32 caractères minimum (le serveur refuse de démarrer sinon) : openssl rand -hex 32
# Signe le cookie de session (__Host-oubli_sid, HttpOnly, Secure, SameSite=Lax en production).
SESSION_SECRET=
# Chemin de la base SQLite (créée automatiquement)
DATABASE_PATH=./data/oubli.sqlite
# Mode démo : les courtiers « répondent » automatiquement en quelques minutes (ne jamais activer en production)
DEMO_MODE=true
# Courrier sortant. Vide = les e-mails sont écrits dans data/outbox/ au lieu d'être envoyés.
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=
MAIL_FROM="Oubli <demandes@votre-domaine.fr>"
MAIL_REPLY_TO=demandes@votre-domaine.fr
# En SMTP réel, seuls les courtiers dont le contact est vérifié (admin) reçoivent des demandes, sauf si :
ALLOW_UNVERIFIED_CONTACTS=false
# Jeton attendu dans l'en-tête X-Inbound-Token par le webhook /api/inbound (réponses des courtiers).
# 16 caractères minimum (openssl rand -hex 24) ; vide ou trop court = webhook désactivé (401). Les cookies y sont ignorés.
INBOUND_TOKEN=
# Stripe (vide = abonnement simulé, activé immédiatement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comptes administrateurs (séparés par des virgules) : accès à /api/admin/*
ADMIN_EMAILS=
# Identité du mandataire dans les courriers
COMPANY_NAME=Oubli SAS
COMPANY_ADDRESS=12 rue des Capucins, 69001 Lyon, France
# Fréquence du planificateur en ms (défaut : 60000, 20000 en démo)
SCHEDULER_INTERVAL_MS=
# Derrière un proxy (Render, Fly, Nginx) : TRUST_PROXY=1 (nombre de proxys de confiance) ou une liste d'adresses/CIDR.
# Détermine l'adresse IP utilisée par la limitation de débit, le verrouillage et le journal des sessions ;
# ne l'activez que si un proxy de confiance réécrit X-Forwarded-For, sinon elle serait falsifiable.
TRUST_PROXY=
