# Copiez ce fichier en .env et adaptez-le. Sans .env, le serveur démarre en mode développement/démo.
PORT=3000
NODE_ENV=development
# URL publique de l'application : utilisée dans les e-mails et les redirections Stripe, et acceptée comme origine
# légitime (en-têtes Origin/Referer) par la protection CSRF, en plus de l'hôte de la requête.
APP_URL=http://localhost:3000
# Obligatoire en production, 32 caractères minimum (le serveur refuse de démarrer sinon) : openssl rand -hex 32
# Signe le cookie de session (__Host-oubli_sid, HttpOnly, Secure, SameSite=Lax en production).
SESSION_SECRET=
# Chemin de la base SQLite (créée automatiquement). La base n'est pas chiffrée par l'application : chiffrez le volume.
DATABASE_PATH=./data/oubli.sqlite
# Sauvegardes quotidiennes de la base (7 conservées, fichiers 0600), hors des dossiers publics. Vide = désactivé.
# Exemple : /srv/oubli/data/backups (volume persistant, avec une copie hors site)
BACKUP_DIR=
# Délai laissé aux requêtes en cours à l'arrêt (SIGTERM), en ms : sous les 10 s de « docker stop »
SHUTDOWN_TIMEOUT_MS=8000
# Mode démo : les courtiers « répondent » automatiquement en quelques minutes (ne jamais activer en production)
DEMO_MODE=true
# Courrier sortant. Vide = les e-mails sont écrits dans OUTBOX_DIR (data/outbox/ par défaut) au lieu d'être envoyés.
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=
OUTBOX_DIR=
MAIL_FROM="Oubli <demandes@votre-domaine.fr>"
MAIL_REPLY_TO=demandes@votre-domaine.fr
# En SMTP réel, seuls les courtiers dont le contact est vérifié (admin) reçoivent des demandes, sauf si :
ALLOW_UNVERIFIED_CONTACTS=false
# Site ajouté par un abonné : l'adresse publiée par le site lui-même, sur son propre domaine, est utilisée sans attendre
# la vérification de l'équipe (off pour l'exiger). Une adresse seulement présumée (privacy@domaine) attend toujours.
AUTO_SEND_SITE_CONTACTS=on
# Recherche de l'adresse de contact sur les sites ajoutés (off = désactivée, l'adresse est présumée)
SITE_DISCOVERY=on
# Jeton attendu dans l'en-tête X-Inbound-Token par le webhook /api/inbound (réponses des courtiers).
# 16 caractères minimum (openssl rand -hex 24) ; vide ou trop court = webhook désactivé (401). Les cookies y sont ignorés.
INBOUND_TOKEN=
# Stripe (vide = abonnement simulé, activé immédiatement)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Adresse de l'API Stripe (vide = https://api.stripe.com/v1). Sert aux tests (faux Stripe) ; https obligatoire en production.
STRIPE_API_BASE=
# Comptes administrateurs (séparés par des virgules) : accès à /api/admin/*. N'y inscrivez que des adresses dont vous
# contrôlez la boîte : en production, l'accès n'est accordé qu'après le lien de confirmation envoyé à l'adresse.
ADMIN_EMAILS=
# Confirmation de l'adresse des administrateurs : on en production, off sinon. on|off pour forcer.
ADMIN_EMAIL_VERIFICATION=
# Double authentification exigée pour l'administration : on en production, off sinon. on|off pour forcer.
# Les clés de double authentification sont chiffrées avec SESSION_SECRET : sauvegardez-le avec la base ; s'il change,
# seuls les codes de secours (ou « npm run admin -- 2fa-off <adresse> ») permettent de se reconnecter.
ADMIN_REQUIRE_2FA=
# Identité du mandataire dans les courriers
COMPANY_NAME=Oubli SAS
COMPANY_ADDRESS=12 rue des Capucins, 69001 Lyon, France
# Fréquence du planificateur en ms (défaut : 60000, 20000 en démo)
SCHEDULER_INTERVAL_MS=
# Derrière un proxy (Render, Fly, Nginx) : TRUST_PROXY=1 (nombre de proxys de confiance) ou une liste d'adresses/CIDR.
# Détermine l'adresse IP utilisée par la limitation de débit, le verrouillage et le journal des sessions ;
# ne l'activez que si un proxy de confiance réécrit X-Forwarded-For, sinon elle serait falsifiable.
TRUST_PROXY=
